# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Torn API
TORN_API_KEY=your_torn_api_key

# Server
PORT=3000
SESSION_SECRET=your_session_secret
NODE_ENV=development

# MongoDB
MONGO_URI=your_mongodb_connection_string

# ─── Email Notifications (Resend) ─────────────────────────────────────────────
# Primary email delivery for weekly snapshots and application notifications.
# Get an API key at https://resend.com (free tier: 100 emails/day)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM_EMAIL=SSG Server <notifications@yourdomain.com>

# Fallback notification emails (comma-separated) if ownership emails can't be
# resolved from their User profiles. Only used as a last resort.
NOTIFY_EMAILS=snowvaletorn@gmail.com

# ─── (Commented out) Discord ──────────────────────────────────────────────────
# Discord is currently disabled due to a temporary IP ban.
# Uncomment these when the ban is lifted.
# DISCORD_WEBHOOK_URL=your_discord_webhook_url
# SNAPSHOT_DISCORD_CHANNEL_ID=your_snapshot_channel_id
# DISCORD_CLIENT_ID=your_discord_client_id
# DISCORD_CLIENT_SECRET=your_discord_client_secret
# DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback
# DISCORD_BOT_TOKEN=your_discord_bot_token