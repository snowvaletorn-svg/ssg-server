# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Discord Bot
DISCORD_BOT_TOKEN=your_discord_bot_token

# Torn API
TORN_API_KEY=your_torn_api_key

# Server
PORT=3000
SESSION_SECRET=your_session_secret
NODE_ENV=development

# MongoDB
MONGO_URI=your_mongodb_connection_string

# ─── Weekly Snapshot Notifications ────────────────────────────────────────────
# Discord channel to post the weekly CSV report to (bot must have send/attach permissions)
SNAPSHOT_DISCORD_CHANNEL_ID=your_snapshot_channel_id

# Email backup — if Discord fails, the CSV is emailed here
SNAPSHOT_EMAIL_TO=your@email.com

# SMTP settings (Gmail example: use App Password, not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
