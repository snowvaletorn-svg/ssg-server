              </div>
              <div class="card-body">
                <div style="display:flex;flex-direction:column;gap:1rem;">
                  <div>
                    <a href="https://update.greasyfork.org/scripts/566690/Torn%20City%20-%20Company%20Stock%20Manager%20%28Smart%20Balance%29.user.js">Company Stock Manager (Smart Balance)</a>
                    <p style="color: #888;">Balances stock to equal day counts. (Purely informational badges + Smart Balance button)
                    </p>
                  </div>
                </div>
              </div>
            </div>
            <!--seperator-->
          </section>




          <!-- ── COMPANIES ── -->
          <section id="companies" class="section">
            <div class="section-header">
              <h3>🏢 Company Management</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <button class="btn btn-primary btn-small" onclick="fetchCompanies()">↻ Refresh</button>
                <button class="btn btn-small btn-outline" onclick="openHelp('companies')">❓ Help</button>
                <% if (isOwner) { %>
                  <button class="btn btn-small btn-outline" onclick="showAddCompanyForm()">➕ Add Company</button>
                  <% } %>
              </div>
            </div>

            <div id="companies-data">
              <div class="empty-state">
                <span class="empty-icon">🏢</span>
                <p>Click Refresh to load company data.</p>
                <p class="muted">Shows details for faction-owned companies you have access to.</p>
              </div>
            </div>

            <!-- Add Company Form (Ownership only) -->
            <% if (isOwner) { %>
              <div id="add-company-form" class="card mt-2" style="display:none;">
                <div class="card-header">➕ Add New Company</div>
                <div class="card-body">
                  <div style="display:flex;flex-direction:column;gap:1rem;">
                    <div>
                      <label class="apply-label">Company ID</label>
                      <input type="number" id="new-company-id" class="form-input" placeholder="e.g. 115695" />
                    </div>
                    <div>
                      <label class="apply-label">Director's Torn ID</label>
                      <input type="number" id="new-company-director" class="form-input" placeholder="e.g. 3808908" />
                    </div>
                    <div style="display:flex;gap:0.75rem;">
                      <button class="btn btn-primary" onclick="addCompany()">Add Company</button>
                      <button class="btn btn-outline" onclick="hideAddCompanyForm()">Cancel</button>
                    </div>
                    <div id="add-company-status"></div>
                  </div>
                </div>
              </div>
              <% } %>

                <!-- Company Detail Modal -->
                <div id="company-detail-modal" class="help-modal-overlay" style="display:none;"
                  onclick="closeCompanyDetail(event)">
                  <div class="help-modal" style="max-width:1200px;">
                    <div class="help-modal-header">
                      <span id="company-detail-title">Company Details</span>
                      <button class="help-close-btn"
                        onclick="document.getElementById('company-detail-modal').style.display='none'">✕</button>
                    </div>
                    <div class="help-modal-body" id="company-detail-body"></div>
                  </div>
                </div>
          </section>

          <!-- ── ADMIN ── -->
          <% if (isOwner || isLeadership) { %>
            <section id="admin" class="section">
              <div class="section-header">
                <h3>Admin Panel</h3>
                <button class="btn btn-small btn-outline" onclick="openHelp('admin')">❓ Help</button>
              </div>

              <!-- Admin Tab Navigation -->
              <div class="admin-tabs">
                <button class="admin-tab active" data-tab="member-overview"
                  onclick="showAdminTab('member-overview', this)">👥 Member Overview</button>
                <button class="admin-tab" data-tab="faction-loans" onclick="showAdminTab('faction-loans', this)">📋
                  Faction Loans</button>
                <button class="admin-tab" data-tab="weapon-armor" onclick="showAdminTab('weapon-armor', this)">⚔️
                  Weapon & Armor</button>
                <button class="admin-tab" data-tab="medical-inventory"
                  onclick="showAdminTab('medical-inventory', this)">💊 Medical Inventory</button>
                <button class="admin-tab" data-tab="drug-inventory" onclick="showAdminTab('drug-inventory', this)">💉
                  Drug Inventory</button>
                <button class="admin-tab" data-tab="utilities-inventory" onclick="showAdminTab('utilities-inventory', this)">🧰
                  Utilities</button>
                <button class="admin-tab" data-tab="weekly-snapshot" onclick="showAdminTab('weekly-snapshot', this)">📊
                  Weekly Snapshot</button>
              </div>

              <!-- Tab Content: Member Overview -->
              <div id="tab-member-overview" class="admin-tab-content active">
                <div class="section-header" style="margin-top:0;">
                  <h3>Member Overview</h3>
                  <div style="display:flex;gap:0.75rem;">
                    <button class="btn btn-primary btn-small" onclick="fetchMemberOverview()">↻ Refresh</button>
                    <button class="btn btn-small btn-outline" onclick="exportOverviewCSV()">⬇️ Export CSV</button>
                  </div>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Enriched data shown for members with a saved API key. Click any column header to sort.
                </p>
                <div id="admin-overview-data">
                  <div class="empty-state">
                    <span class="empty-icon">🛡️</span>
                    <p>Click Refresh to load member overview.</p>
                  </div>
                </div>
              </div>

              <!-- Tab Content: Faction Loans -->
              <div id="tab-faction-loans" class="admin-tab-content">
                <div class="section-header" style="margin-top:0;">
                  <h3>Faction Loans</h3>
                  <button class="btn btn-primary btn-small" onclick="fetchFactionLoans()">↻ Refresh</button>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Shows which members have faction armor and weapons loaned out.
                </p>
                <div id="admin-loans-data">
                  <div class="empty-state">
                    <span class="empty-icon">🛡️</span>
                    <p>Click Refresh to load faction loans data.</p>
                  </div>
                </div>
              </div>

              <!-- Tab Content: Weapon & Armor Inventory -->
              <div id="tab-weapon-armor" class="admin-tab-content">
                <div class="section-header" style="margin-top:0;">
                  <h3>Weapon & Armor Inventory</h3>
                  <button class="btn btn-primary btn-small" onclick="fetchWeaponArmorInventory()">↻ Refresh</button>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Complete inventory of faction weapons and armor available in the armory.
                </p>
                <div id="admin-weapon-armor-data">
                  <div class="empty-state">
                    <span class="empty-icon">⚔️</span>
                    <p>Click Refresh to load weapon and armor inventory.</p>
                  </div>
                </div>
              </div>

              <!-- Tab Content: Medical Inventory -->
              <div id="tab-medical-inventory" class="admin-tab-content">
                <div class="section-header" style="margin-top:0;">
                  <h3>Medical Inventory</h3>
                  <button class="btn btn-primary btn-small" onclick="fetchMedicalInventory()">↻ Refresh</button>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Medical supplies available in the faction armory (rope, first aid kits, etc.).
                </p>
                <div id="admin-medical-inventory-data">
                  <div class="empty-state">
                    <span class="empty-icon">💊</span>
                    <p>Click Refresh to load medical inventory.</p>
                  </div>
                </div>
              </div>

              <!-- Tab Content: Drug Inventory -->
              <div id="tab-drug-inventory" class="admin-tab-content">
                <div class="section-header" style="margin-top:0;">
                  <h3>Drug Inventory</h3>
                  <button class="btn btn-primary btn-small" onclick="fetchDrugInventory()">↻ Refresh</button>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Drugs available in the faction armory (Xans, Vicodin, etc.).
                </p>
                <div id="admin-drug-inventory-data">
                  <div class="empty-state">
                    <span class="empty-icon">💉</span>
                    <p>Click Refresh to load drug inventory.</p>
                  </div>
                </div>
              </div>

              <!-- Tab Content: Utilities Inventory -->
              <div id="tab-utilities-inventory" class="admin-tab-content">
                <div class="section-header" style="margin-top:0;">
                  <h3>Utilities Inventory</h3>
                  <button class="btn btn-primary btn-small" onclick="fetchUtilitiesInventory()">↻ Refresh</button>
                </div>
                <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                  Utilities armory (OC &amp; crime items). Loaned items are tied to each member's organized crime — tools
                  should be returned when the crime completes, while materials are consumed.
                </p>
                <div id="admin-utilities-inventory-data">
                  <div class="empty-state">
                    <span class="empty-icon">🧰</span>
                    <p>Click Refresh to load the Utilities inventory.</p>
                  </div>
                </div>
              </div>

              <!--Weekly Stats-->
              <% if (isOwner) { %>
                <div id="tab-weekly-snapshot" class="admin-tab-content">
                  <div class="section-header" style="margin-top:0;">
                    <h3>Weekly Snapshot</h3>
                    <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                      <button class="btn btn-primary btn-small" onclick="takeWeeklySnapshot()">📸 Take
                        Snapshot</button>
                      <button class="btn btn-small" style="background:#2a2828;border:1px solid #555;color:#c0bcbc;"
                        onclick="takeSnapshotTestRun()">🧪 Test Run</button>
                      <a href="/api/admin/snapshot/latest/csv" class="btn btn-success">📥 Export Status Report</a>
                    </div>
                  </div>
                  <p class="muted" style="margin-bottom:1rem;">Take a snapshot of all faction members' total stats. This
                    function
                    is done automatically each Sunday at 12:00pm (noon) TCT.
                    <br><span style="font-size:0.8rem;color:#666;">Use <strong style="color:#888;">Test Run</strong>
                      to validate output without affecting real weekly snapshots — saves with a unique test ID and
                      shows a CSV preview.</span>
                    <br><span style="font-size:0.8rem;color:#666;">Use <strong style="color:#888;">
                        Export Status Report </strong> to export the latest status report that would have been
                      emailed.</span>
                  </p>
                  <div id="snapshot-status"></div>
                  <div id="snapshot-test-status" style="margin-top:1rem;"></div>
                  <div id="snapshot-test-csv" style="display:none;margin-top:1rem;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                      <span style="font-size:0.85rem;color:#888;">📄 CSV Preview (first 10 rows)</span>
                      <button class="btn btn-small btn-outline" onclick="downloadTestCsv()">⬇️ Download Full
                        CSV</button>
                    </div>
                    <pre id="snapshot-test-csv-content"
                      style="background:#1a1919;border:1px solid #333;border-radius:6px;padding:0.75rem;font-size:0.75rem;color:#c0bcbc;overflow-x:auto;max-height:200px;overflow-y:auto;white-space:pre;"></pre>
                  </div>
                </div>
                <% } %>
            </section>
            <% } %>

        </main>
      </div>
    </div>
  </div>
  <!-- ── HELP MODAL ── -->
  <div id="help-modal" class="help-modal-overlay" onclick="closeHelpOnBackdrop(event)">
    <div class="help-modal">
      <div class="help-modal-header">
        <span id="help-modal-title">Help</span>
        <button class="help-close-btn" onclick="closeHelp()">✕</button>
      </div>
      <div class="help-modal-tabs" id="help-tabs"></div>
      <div class="help-modal-body" id="help-modal-body"></div>
    </div>
  </div>
  <script>
    // Global flags for client-side JavaScript
    const IS_LEADERSHIP = <%= (isOwner || isLeadership) ? 'true' : 'false' %>;
    const IS_OWNER = <%= isOwner ? 'true' : 'false' %>;
    const IS_EMPLOYEE = <%= isEmployee ? 'true' : 'false' %>;
    const IS_UTILITY_LOANING = <%= isUtilityLoaning ? 'true' : 'false' %>;
  </script>
  <script src="/js/dashboard.js">
  </script>
</body>

</html>