<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - SSG Server</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Montserrat:wght@400;600;700&display=swap"
    rel="stylesheet">
</head>

<body>
  <div class="navbar">
    <div class="container">
      <h1>SSG Server</h1>
      <div class="nav-links">
        <span class="welcome-text">Welcome, <strong>
            <%= user.ssgNick || user.username %>
          </strong></span>
        <button class="btn btn-outline" onclick="openHelp('profile')">❓ Help</button>
        <a href="/" class="btn">Home</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="dashboard">
      <div class="dashboard-layout">

        <!-- Sidebar -->
        <aside class="sidebar">
          <nav class="sidebar-nav">
            <a href="#profile" class="nav-item active" onclick="showSection('profile', this)">👤 Profile</a>
            <a href="#torn" class="nav-item" onclick="showSection('torn', this)">🎮 Personal Stats</a>
            <a href="#faction" class="nav-item" onclick="showSection('faction', this)">⚔️ Faction</a>
            <a href="#travel" class="nav-item" onclick="showSection('travel', this)">✈️ Travel</a>
            <a href="#training" class="nav-item" onclick="showSection('training', this)">📚 Training</a>
            <a href="#bank-rates" class="nav-item" onclick="showSection('bank-rates', this)">🏦 Bank Rates</a>
            <% if (isOwner || isLeadership || isWarlord) { %>
              <a href="#war" class="nav-item" onclick="showSection('war', this)">🪖 War</a>
              <% } %>
                <a href="#oc" class="nav-item" onclick="showSection('oc', this)">🗝️ OC Tracking</a>
                <% if (isOwner || isLeadership) { %>
                  <a href="#admin" class="nav-item" onclick="showSection('admin', this)">🛡️ Admin</a>
                  <% } %>
          </nav>
        </aside>

        <!-- Main Content -->
        <main class="dashboard-content">

          <!-- ── PROFILE ── -->
          <section id="profile" class="section active">
            <div class="section-header">
              <h3>Your Profile</h3>
              <button class="btn btn-small btn-outline" onclick="openHelp('profile')">❓ Help</button>
            </div>
            <div class="profile-card">
              <div class="profile-avatar">
                <% if (user.tornAvatar) { %>
                  <img src="<%= user.tornAvatar %>" alt="<%= user.username %>"
                    style="width: 80px; height: 80px; border-radius: 50%;">
                  <% } else { %>
                    <div class="avatar-placeholder">
                      <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
              </div>
              <div class="profile-info">
                <div class="profile-name">
                  <%= user.ssgNick || user.username %>
                </div>
                <div class="profile-detail"><span class="label">Username</span><span class="value">
                    <%= user.username %>
                  </span></div>
                    <!-- Email -->
                    <% if (isOwner || isLeadership) { %>
                       <div class="profile-detail"><span class="label">Email</span><span class="value" id="user-email">
                           <%= userEmail || 'Not provided' %>
                         </span></div>
                      <% } %>
                    <% if (user.factionPosition) { %>
                      <div class="profile-detail"><span class="label">Faction Position</span>
                        <span class="value">
                          <span class="role-badge role-<%= user.positionGroup || 'member' %>">
                            <%= user.factionPosition %>
                          </span>
                        </span>
                      </div>
                      <% } %>
              </div>
            </div>

            <!-- Torn Email -->
            <div class="card mt-2">
              <div class="card-header">📧 Torn Email Address</div>
              <% if (isOwner || isLeadership) { %>
                <div class="card-body">
                  <div style="display:flex;gap:0.5rem;align-items:center;">
                    <input type="email" id="email-input" class="form-input" value="<%= userEmail || '' %>"
                      placeholder="Enter your email address" style="flex:1;" />
                    <button class="btn btn-primary btn-small" onclick="saveUserEmail()">Save</button>
                  </div>
                  <div id="email-status" style="margin-top:0.5rem;"></div>
                </div>
                <% } %>
                  <div class="card-body">
                  </div>

                  <!-- Personal Torn API Key -->
                  <div class="card mt-2">
                    <div class="card-header">🔑 Torn API Key</div>
                    <div class="card-body">
                      <% if (tornApiKey) { %>
                        <p class="success-text">✅ Torn API key is saved.</p>
                        <button class="btn btn-small btn-outline" onclick="showKeyForm()">Update Key</button>
                        <% } else { %>
                          <p class="muted">No Torn API key saved yet. Add one to enable Torn stats.</p>
                          <% } %>
                            <div id="key-form" class="<%= tornApiKey ? 'hidden' : '' %>">
                              <div class="input-group mt-1">
                                <input type="text" id="torn-key-input" class="form-input"
                                  placeholder="Enter your Torn API key..." />
                                <button class="btn btn-primary" onclick="saveTornKey()">Save Key</button>
                              </div>
                              <p class="hint">
                                Get your key at
                                <a href="https://www.torn.com/preferences.php#tab=api" target="_blank" rel="noopener">
                                  torn.com → Preferences → API
                                </a>— set access level to <strong style="color:#c0bcbc;">Full Access</strong>.
                              </p>
                            </div>
                            <div id="key-status" class="mt-1"></div>
                    </div>
                  </div>

                  <!-- Faction API Key (Ownership only) -->
                  <% if (isOwner) { %>
                    <div class="card mt-2">
                      <div class="card-header">🏰 Faction API Key <span
                          style="font-size:0.75rem;color:#666;font-weight:400;">(Ownership only)</span></div>
                      <div class="card-body">
                        <% if (hasFactionKey) { %>
                          <p class="success-text">✅ Faction API key is configured.</p>
                          <button class="btn btn-small btn-outline" onclick="showFactionKeyForm()">Update Key</button>
                          <% } else { %>
                            <p class="muted">No faction API key set. Configure one to enable faction features for all
                              members.
                            </p>
                            <% } %>
                              <div id="faction-key-form" class="<%= hasFactionKey ? 'hidden' : '' %>">
                                <div class="input-group mt-1">
                                  <input type="text" id="faction-key-input" class="form-input"
                                    placeholder="Enter faction Torn API key..." />
                                  <button class="btn btn-primary" onclick="saveFactionKey()">Save Key</button>
                                </div>
                                <p class="hint">Use a faction leader/co-leader's Torn API key with faction permissions.
                                </p>
                              </div>
                              <div id="faction-key-status" class="mt-1"></div>
                      </div>
                    </div>
                    <% } %>
          </section>


          <!-- ── TORN STATS ── -->
          <section id="torn" class="section">
            <div class="section-header">
              <h3>Your Personal Stats</h3>
              <button class="btn btn-primary btn-small" onclick="fetchTornUser()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('torn')">❓ Help</button>
            </div>
            <div id="torn-user-data">
              <div class="empty-state">
                <span class="empty-icon">🎮</span>
                <p>Click Refresh to load your stats.</p>
                <p class="muted">Make sure your API key is saved in your profile.</p>
              </div>
            </div>

            <div class="section-header" style="margin-top:2rem;">
              <h3>Honors, Merits & Awards</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <select id="honors-filter" class="channel-dropdown" onchange="filterHonors()">
                  <option value="all">All</option>
                  <option value="earned">Earned only</option>
                  <option value="unearned">Not earned</option>
                </select>
                <select id="honors-sort" class="channel-dropdown" onchange="filterHonors()">
                  <option value="earned-first">Earned first</option>
                  <option value="unearned-first">Unearned first</option>
                  <option value="rarity-asc">Rarity (rarest first)</option>
                  <option value="rarity-desc">Rarity (common first)</option>
                  <option value="name">Name A-Z</option>
                </select>
                <button class="btn btn-primary btn-small" onclick="fetchHonors()">Load</button>
              </div>
            </div>
            <div id="honors-data">
              <div class="empty-state">
                <span class="empty-icon">🏅</span>
                <p>Click Load to fetch your honors, merits and awards.</p>
              </div>
            </div>
            <div id="honors-table-container"></div>

            <div class="section-header" style="margin-top:2rem;">
              <h3>Crime Record</h3>
              <button class="btn btn-primary btn-small" onclick="fetchCrimeExp()">Load</button>
            </div>
            <div id="crime-exp-data">
              <div class="empty-state">
                <span class="empty-icon">🔪</span>
                <p>Click Load to fetch your crime record.</p>
              </div>
            </div>

            <!-- Racing Stats -->
            <div class="section-header" style="margin-top:2rem;">
              <h3>Racing Stats</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <label style="font-size:0.75rem;color:#888;">Last</label>
                <input id="racing-limit" type="number" value="100" min="1" max="1000"
                  style="width:60px;background:#1a1919;border:1px solid #333;color:#c0bcbc;border-radius:4px;padding:2px 6px;font-size:0.8rem;">
                <label style="font-size:0.75rem;color:#888;">races</label>
                <button class="btn btn-primary btn-small" onclick="fetchRacingStats()">Load</button>
              </div>
            </div>
            <div id="racing-stats-data">
              <div class="empty-state">
                <span class="empty-icon">🏎️</span>
                <p>Set a limit and click Load to fetch your racing stats.</p>
              </div>
            </div>
          </section>

          <!-- ── FACTION ── -->
          <section id="faction" class="section">
            <div class="section-header">
              <h3>Faction Stats</h3>
              <button class="btn btn-primary btn-small" onclick="fetchFaction()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('faction')">❓ Help</button>
            </div>
            <div id="faction-data">
              <div class="empty-state">
                <span class="empty-icon">⚔️</span>
                <p>Click Refresh to load faction data.</p>
              </div>
            </div>

          </section>

          <!-- ── TRAVEL ── -->
          <section id="travel" class="section">
            <div class="section-header">
              <h3>Travel Status</h3>
              <button class="btn btn-primary btn-small" onclick="fetchTravel()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('travel')">❓ Help</button>
            </div>

            <div id="travel-status">
              <div class="empty-state">
                <span class="empty-icon">✈️</span>
                <p>Click Refresh to load your travel status.</p>
              </div>
            </div>

            <!-- Travel Configuration -->
            <div class="card mt-2" style="background:#1a1919;border:1px solid #2a2828;">
              <div class="card-body">
                <div style="display:flex;flex-wrap:wrap;gap:1.5rem;align-items:flex-start;">
                  <!-- Travel Method -->
                  <div>
                    <label
                      style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.4rem;">Travel
                      Method</label>
                    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="radio" name="travelMethod" value="standard" checked
                          onchange="renderTravelProfits()" /> Standard
                      </label>
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="radio" name="travelMethod" value="airstrip" onchange="renderTravelProfits()" />
                        Airstrip
                      </label>
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="radio" name="travelMethod" value="private" onchange="renderTravelProfits()" />
                        Private
                      </label>
                    </div>
                  </div>
                  <!-- Item Types -->
                  <div>
                    <label
                      style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.4rem;">Item
                      Types</label>
                    <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="checkbox" id="type-plushie" checked onchange="renderTravelProfits()" /> Plushie
                      </label>
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="checkbox" id="type-flower" checked onchange="renderTravelProfits()" /> Flower
                      </label>
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="checkbox" id="type-drug" checked onchange="renderTravelProfits()" /> Drug
                      </label>
                      <label
                        style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                        <input type="checkbox" id="type-other" onchange="renderTravelProfits()" /> Other
                      </label>
                    </div>
                  </div>
                  <!-- Quantity -->
                  <div>
                    <label
                      style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.4rem;">Quantity</label>
                    <input type="number" id="profit-quantity" class="form-input" value="25" min="5" max="29"
                      onchange="renderTravelProfits()" style="width:80px;" />
                  </div>
                  <!-- Sort -->
                  <div>
                    <label
                      style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.4rem;">Sort
                      By</label>
                    <select id="profit-sort" class="channel-dropdown" onchange="renderTravelProfits()"
                      style="min-width:140px;">
                      <option value="profitPerRun" selected>Profit/Run</option>
                      <option value="profit">Profit/Item</option>
                      <option value="profitPercent">Profit %</option>
                      <option value="country">Country</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>

            <!-- Combined Travel Profits Table -->
            <div class="section-header" style="margin-top:2rem;">
              <h3>💰 Travel Profits</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <select id="travel-country-select" class="channel-dropdown" onchange="renderTravelProfits()"
                  style="min-width:180px;">
                  <option value="">— All Countries —</option>
                  <option value="mex">Mexico</option>
                  <option value="cay">Cayman Islands</option>
                  <option value="can">Canada</option>
                  <option value="haw">Hawaii</option>
                  <option value="uni">United Kingdom</option>
                  <option value="arg">Argentina</option>
                  <option value="swi">Switzerland</option>
                  <option value="jap">Japan</option>
                  <option value="chi">China</option>
                  <option value="uae">UAE</option>
                  <option value="sou">South Africa</option>
                </select>
                <button class="btn btn-primary btn-small" onclick="fetchTravelProfits()">↻ Refresh</button>
              </div>
            </div>
            <div id="travel-profits-data">
              <div class="empty-state">
                <span class="empty-icon">💰</span>
                <p>Click Refresh to load travel profit opportunities.</p>
                <p class="muted">Shows items available abroad with current market prices and profit calculations.</p>
              </div>
            </div>
          </section>
          <!-- ── TRAINING ── -->
          <section id="training" class="section">
            <div class="section-header">
              <h3>Training Resources</h3>
              <button class="btn btn-small btn-outline" onclick="openHelp('training')">❓ Help</button>
            </div>
            <% if (accessibleTraining && accessibleTraining.length> 0) { %>
              <div class="training-grid">
                <% accessibleTraining.forEach(function(ch) { %>
                  <div class="training-card">
                    <div class="training-card-header">
                      <%= ch.name %>
                    </div>
                    <div class="training-card-body">
                      <p class="training-desc">
                        <%= ch.description %>
                      </p>
                      <!-- leave these discord instances -->
                      <a href="https://discord.com/channels/1432576178383753309/<%= ch.id %>" target="_blank"
                        rel="noopener" class="btn btn-primary">
                        Open Link ↗
                      </a>
                    </div>
                  </div>
                  <% }); %>
              </div>
              <% } else { %>
                <div class="empty-state">
                  <span class="empty-icon">🔒</span>
                  <p>You don't have access to any training channels.</p>
                  <p class="muted">Contact leadership to get your roles assigned.</p>
                </div>
                <% } %>
          </section>

          <!-- ── BANK RATES ── -->
          <section id="bank-rates" class="section">
            <div class="section-header">
              <h3>🏦 Bank Rates</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <button class="btn btn-primary btn-small" onclick="fetchBankRates()">↻ Refresh</button>
                <span class="muted" style="font-size:0.75rem;">Updated hourly</span>
              </div>
            </div>
            <div id="bank-rates-data">
              <div class="empty-state">
                <span class="empty-icon">🏦</span>
                <p>Click Refresh to load current bank interest rates.</p>
              </div>
            </div>
            <div class="section-header" style="margin-top:2rem;">
              <h3>💰 Calculator</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <label style="font-size:0.75rem;color:#888;">Amount to deposit:</label>
                <input id="bank-amount-input" type="number" value="1000000" min="0"
                  style="width:120px;background:#1a1919;border:1px solid #333;color:#c0bcbc;border-radius:4px;padding:2px 6px;font-size:0.8rem;">
                <button class="btn btn-primary btn-small" onclick="calculateBankEarnings()">Calculate</button>
                <button class="btn btn-small btn-outline" onclick="clearBankCalculator()">Clear</button>
              </div>
            </div>
            <div id="bank-calculator-results">
              <div class="empty-state">
                <span class="empty-icon">📊</span>
                <p>Enter an amount and click Calculate to see potential earnings.</p>
              </div>
            </div>
          </section>

          <!-- War Section -->
          <% if (isOwner || isLeadership || isWarlord) { %>
            <section id="war" class="section">
              <div class="section-header">
                <h3>War Panel</h3>
                <button class="btn btn-small btn-outline" onclick="openHelp('war')">❓ Help</button>
              </div>

              <!-- War Data Overview -->
              <div class="section-header" style="margin-top:0;">
                <h3>War Data Overview</h3>
                <div style="display:flex;gap:0.75rem;">
                  <button class="btn btn-primary btn-small" onclick="fetchWarDataOverview()">↻ Refresh</button>
                </div>
              </div>
              <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                Enriched data shown for war to assist Warlords in planning. Click any column header to sort.
              </p>
              <div id="war-overview-data">
                <div class="empty-state">
                  <span class="empty-icon">🛡️</span>
                  <p>Click Refresh to load war data overview.</p>
                </div>
              </div>
              <div class="section-header" style="margin-top:2rem;">
                <h3>War Stats</h3>
                <button class="btn btn-primary btn-small" onclick="fetchWarStats()">↻ Refresh</button>
              </div>
              <div id="war-stats-data">
                <div class="empty-state">
                  <span class="empty-icon">⚔️</span>
                  <p>Click Refresh to load current war stats.</p>
                </div>
              </div>
            </section>
            <% } %>

              <!-- ── ORGANIZED CRIME ── -->
              <section id="oc" class="section">
                <div class="section-header">
                  <h3>🗝️ Organized Crime Tracking</h3>
                  <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                    <select id="oc-days-back" class="channel-dropdown" style="min-width:120px;">
                      <option value="7">Last 7 days</option>
                      <option value="30" selected>Last 30 days</option>
                      <option value="90">Last 90 days</option>
                      <option value="180">Last 6 months</option>
                      <option value="365">Last year</option>
                      <option value="all">All time</option>
                    </select>
                    <button class="btn btn-primary btn-small" onclick="refreshCrimes()">↻ Refresh</button>
                    <button class="btn btn-small btn-outline" onclick="openHelp('oc')">❓ Help</button>
                  </div>
                </div>

                <!-- OC Crimes List -->
                <div class="section-header" style="margin-top:0;">
                  <h3>Recent Crimes</h3>
                  <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                    <button class="btn btn-small btn-outline" onclick="openParticipantHistoryWidget()">📊 Member
                      History</button>
                    <select id="oc-status-filter" class="channel-dropdown" onchange="filterCrimes()">
                      <option value="all">All Status</option>
                      <option value="pending">Pending</option>
                      <option value="succeeded">Succeeded</option>
                      <option value="failed">Failed</option>
                    </select>
                    <select id="oc-sort" class="channel-dropdown" onchange="filterCrimes()">
                      <option value="timeStarted-desc">Newest First</option>
                      <option value="timeStarted-asc">Oldest First</option>
                      <option value="moneyGain-desc">Highest Money</option>
                      <option value="respectGain-desc">Highest Respect</option>
                    </select>
                  </div>
                </div>
                <div id="oc-crimes-data">
                  <div class="empty-state">
                    <span class="empty-icon">🗝️</span>
                    <p>Click Refresh to load organized crime data.</p>
                    <p class="muted">Shows recent OC attempts with participant details and checkpoint tracking.</p>
                  </div>
                </div>

                <!-- Participant Detail Modal Trigger -->
                <div id="oc-participant-modal" class="help-modal-overlay" style="display:none;"
                  onclick="closeParticipantModal(event)">
                  <div class="help-modal" style="max-width:800px;">
                    <div class="help-modal-header">
                      <span id="participant-modal-title">Participant Details</span>
                      <button class="help-close-btn"
                        onclick="document.getElementById('oc-participant-modal').style.display='none'">✕</button>
                    </div>
                    <div class="help-modal-body" id="participant-modal-body"></div>
                  </div>
                </div>
              </section>

              <!-- ── ADMIN ── -->
              <% if (isOwner || isLeadership) { %>
                <section id="admin" class="section">
                  <div class="section-header">
                    <h3>Admin Panel</h3>
                    <button class="btn btn-small btn-outline" onclick="openHelp('admin')">❓ Help</button>
                  </div>

                  <!-- Admin Tab Navigation -->
                  <div class="admin-tabs">
                    <button class="admin-tab active" data-tab="member-overview"
                      onclick="showAdminTab('member-overview', this)">👥 Member Overview</button>
                    <button class="admin-tab" data-tab="faction-loans" onclick="showAdminTab('faction-loans', this)">📋
                      Faction Loans</button>
                    <button class="admin-tab" data-tab="weapon-armor" onclick="showAdminTab('weapon-armor', this)">⚔️
                      Weapon & Armor</button>
                    <button class="admin-tab" data-tab="medical-inventory"
                      onclick="showAdminTab('medical-inventory', this)">💊 Medical Inventory</button>
                    <button class="admin-tab" data-tab="drug-inventory"
                      onclick="showAdminTab('drug-inventory', this)">💉 Drug Inventory</button>
                    <button class="admin-tab" data-tab="weekly-snapshot"
                      onclick="showAdminTab('weekly-snapshot', this)">📊 Weekly Snapshot</button>
                  </div>

                  <!-- Tab Content: Member Overview -->
                  <div id="tab-member-overview" class="admin-tab-content active">
                    <div class="section-header" style="margin-top:0;">
                      <h3>Member Overview</h3>
                      <div style="display:flex;gap:0.75rem;">
                        <button class="btn btn-primary btn-small" onclick="fetchMemberOverview()">↻ Refresh</button>
                        <button class="btn btn-small btn-outline" onclick="exportOverviewCSV()">⬇️ Export CSV</button>
                      </div>
                    </div>
                    <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                      Enriched data shown for members with a saved API key. Click any column header to sort.
                    </p>
                    <div id="admin-overview-data">
                      <div class="empty-state">
                        <span class="empty-icon">🛡️</span>
                        <p>Click Refresh to load member overview.</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tab Content: Faction Loans -->
                  <div id="tab-faction-loans" class="admin-tab-content">
                    <div class="section-header" style="margin-top:0;">
                      <h3>Faction Loans</h3>
                      <button class="btn btn-primary btn-small" onclick="fetchFactionLoans()">↻ Refresh</button>
                    </div>
                    <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                      Shows which members have faction armor and weapons loaned out.
                    </p>
                    <div id="admin-loans-data">
                      <div class="empty-state">
                        <span class="empty-icon">🛡️</span>
                        <p>Click Refresh to load faction loans data.</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tab Content: Weapon & Armor Inventory -->
                  <div id="tab-weapon-armor" class="admin-tab-content">
                    <div class="section-header" style="margin-top:0;">
                      <h3>Weapon & Armor Inventory</h3>
                      <button class="btn btn-primary btn-small" onclick="fetchWeaponArmorInventory()">↻ Refresh</button>
                    </div>
                    <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                      Complete inventory of faction weapons and armor available in the armory.
                    </p>
                    <div id="admin-weapon-armor-data">
                      <div class="empty-state">
                        <span class="empty-icon">⚔️</span>
                        <p>Click Refresh to load weapon and armor inventory.</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tab Content: Medical Inventory -->
                  <div id="tab-medical-inventory" class="admin-tab-content">
                    <div class="section-header" style="margin-top:0;">
                      <h3>Medical Inventory</h3>
                      <button class="btn btn-primary btn-small" onclick="fetchMedicalInventory()">↻ Refresh</button>
                    </div>
                    <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                      Medical supplies available in the faction armory (rope, first aid kits, etc.).
                    </p>
                    <div id="admin-medical-inventory-data">
                      <div class="empty-state">
                        <span class="empty-icon">💊</span>
                        <p>Click Refresh to load medical inventory.</p>
                      </div>
                    </div>
                  </div>

                  <!-- Tab Content: Drug Inventory -->
                  <div id="tab-drug-inventory" class="admin-tab-content">
                    <div class="section-header" style="margin-top:0;">
                      <h3>Drug Inventory</h3>
                      <button class="btn btn-primary btn-small" onclick="fetchDrugInventory()">↻ Refresh</button>
                    </div>
                    <p class="muted" style="margin-bottom:1rem;font-size:0.85rem;">
                      Drugs available in the faction armory (Xans, Vicodin, etc.).
                    </p>
                    <div id="admin-drug-inventory-data">
                      <div class="empty-state">
                        <span class="empty-icon">💉</span>
                        <p>Click Refresh to load drug inventory.</p>
                      </div>
                    </div>
                  </div>

                  <!--Weekly Stats-->
                  <% if (isOwner) { %>
                    <div id="tab-weekly-snapshot" class="admin-tab-content">
                      <div class="section-header" style="margin-top:0;">
                        <h3>Weekly Snapshot</h3>
                        <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                          <button class="btn btn-primary btn-small" onclick="takeWeeklySnapshot()">📸 Take
                            Snapshot</button>
                          <button class="btn btn-small" style="background:#2a2828;border:1px solid #555;color:#c0bcbc;"
                            onclick="takeSnapshotTestRun()">🧪 Test Run</button>
                        </div>
                      </div>
                      <p class="muted" style="margin-bottom:1rem;">Take a snapshot of all faction members' total stats.
                        <br><span style="font-size:0.8rem;color:#666;">Use <strong style="color:#888;">Test Run</strong>
                          to validate output without affecting real weekly snapshots — saves with a unique test ID and
                          shows a CSV preview.</span>
                      </p>
                      <div id="snapshot-status"></div>
                      <div id="snapshot-test-status" style="margin-top:1rem;"></div>
                      <div id="snapshot-test-csv" style="display:none;margin-top:1rem;">
                        <div
                          style="display:flex;justify-content:space-between;align-items:center;margin-bottom:0.5rem;">
                          <span style="font-size:0.85rem;color:#888;">📄 CSV Preview (first 10 rows)</span>
                          <button class="btn btn-small btn-outline" onclick="downloadTestCsv()">⬇️ Download Full
                            CSV</button>
                        </div>
                        <pre id="snapshot-test-csv-content"
                          style="background:#1a1919;border:1px solid #333;border-radius:6px;padding:0.75rem;font-size:0.75rem;color:#c0bcbc;overflow-x:auto;max-height:200px;overflow-y:auto;white-space:pre;"></pre>
                      </div>
                    </div>
                    <% } %>
                </section>
                <% } %>

        </main>
      </div>
    </div>
  </div>
  <!-- ── HELP MODAL ── -->
  <div id="help-modal" class="help-modal-overlay" onclick="closeHelpOnBackdrop(event)">
    <div class="help-modal">
      <div class="help-modal-header">
        <span id="help-modal-title">Help</span>
        <button class="help-close-btn" onclick="closeHelp()">✕</button>
      </div>
      <div class="help-modal-tabs" id="help-tabs"></div>
      <div class="help-modal-body" id="help-modal-body"></div>
    </div>
  </div>
  <script>
    const IS_LEADERSHIP = <% if (isOwner || isLeadership) { %> true <% } else { %> false <% } %>;
    const IS_OWNER = <% if (isOwner) { %> true <% } else { %> false <% } %>;
  </script>
  <script src="/js/dashboard.js">
  </script>
</body>

</html>