<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard - SSG Server</title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/dashboard.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&family=Montserrat:wght@400;600;700&display=swap"
    rel="stylesheet">
</head>

<body>
  <div class="navbar">
    <div class="container">
      <h1>SSG Server</h1>
      <div class="nav-links">
        <span class="welcome-text">Welcome, <strong>
            <%= user.ssgNick || user.username %>
          </strong></span>
        <button class="btn btn-outline" onclick="openHelp('profile')">❓ Help</button>
        <a href="/" class="btn">Home</a>
        <a href="/logout" class="btn btn-danger">Logout</a>
      </div>
    </div>
  </div>

  <!-- ── PERSISTENT IMPERSONATION BANNER ── -->
  <% if (isImpersonating) { %>
  <div class="impersonation-banner">
    <span>🔍 You are currently viewing as <strong><%= impersonatedRole %></strong> role</span>
    <button class="btn btn-small btn-outline" onclick="clearRoleView()" style="border-color:#f0c040;color:#f0c040;">✕ Return to My View</button>
  </div>
  <% } %>

  <% if (isEmployee) { %>
  <div class="impersonation-banner" style="background: linear-gradient(135deg, #1a5276, #2c3e50); border-bottom: 2px solid #3498db;">
    <span>🏢 <strong>Employee Account</strong> <% if (isTestUser) { %> · 🔬 <strong>TEST ACCOUNT</strong><% } %></span>
  </div>
  <% } %>

  <div class="container">
    <div class="dashboard">
      <div class="dashboard-layout">

        <!-- Sidebar -->
        <aside class="sidebar">
          <nav class="sidebar-nav">
            <% if (!isEmployee) { %>
            <a href="#my-day" class="nav-item active" onclick="showSection('my-day', this)">🏠 My Day</a>
            <a href="#profile" class="nav-item" onclick="showSection('profile', this)">👤 Profile</a>
            <a href="#torn" class="nav-item" onclick="showSection('torn', this)">🎮 Personal Stats</a>
            <% } %>
            <a href="#targets" class="nav-item <%= isEmployee ? 'active' : '' %>" onclick="showSection('targets', this)">🎯 Targets</a>
            <% if (!isEmployee) { %>
            <a href="#faction" class="nav-item" onclick="showSection('faction', this)">⚔️ Faction</a>
            <% } %>
            <a href="#travel" class="nav-item" onclick="showSection('travel', this)">✈️ Travel</a>
            <% if (!isEmployee) { %>
            <a href="#training" class="nav-item" onclick="showSection('training', this)">📚 Training</a>
            <% } %>
            <a href="#bank-rates" class="nav-item" onclick="showSection('bank-rates', this)">🏦 Bank Rates</a>
            <% if (!isEmployee) { %>
            <a href="#war" class="nav-item" onclick="showSection('war', this)">🪖 War</a>
            <% } %>
            <a href="#stocks" class="nav-item" onclick="showSection('stocks', this)">📈 Stocks</a>
            <% if (!isEmployee) { %>
            <a href="#oc" class="nav-item" onclick="showSection('oc', this)">🗝️ OC Tracking</a>
            <% } %>
            <a href="#scripts" class="nav-item" onclick="showSection('scripts', this)">📜 Scripts</a>
            <% if (isOwner || isDirector) { %>
              <a href="#companies" class="nav-item" onclick="showSection('companies', this)">🏢 Companies</a>
              <% } %>
                <% if (isOwner || isLeadership) { %>
                  <a href="#admin" class="nav-item" onclick="showSection('admin', this)">🛡️ Admin</a>
                  <% } %>
          </nav>
        </aside>

        <!-- Main Content -->
        <main class="dashboard-content">

          <!-- ── MY DAY ── -->
          <% if (!isEmployee) { %>
          <section id="my-day" class="section active">
            <div class="section-header">
              <h3>🏠 My Day</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;">
                <button class="btn btn-primary btn-small" onclick="fetchMyDay()">↻ Refresh</button>
                <button class="btn btn-small btn-outline" onclick="openHelp('myDay')">❓ Help</button>
              </div>
            </div>
            <div id="my-day-data">
              <div class="empty-state">
                <span class="empty-icon">⏳</span>
                <p>Loading your day...</p>
              </div>
            </div>
          </section>

          <!-- ── PROFILE ── -->
          <section id="profile" class="section">
            <div class="section-header">
              <h3>Your Profile</h3>
              <button class="btn btn-small btn-outline" onclick="openHelp('profile')">❓ Help</button>
            </div>

            <div class="profile-card">
              <div class="profile-avatar">
                <% if (user.tornAvatar) { %>
                  <img src="<%= user.tornAvatar %>" alt="<%= user.username %>"
                    style="width: 80px; height: 80px; border-radius: 50%;">
                  <% } else { %>
                    <div class="avatar-placeholder">
                      <%= user.username.charAt(0).toUpperCase() %>
                    </div>
                    <% } %>
              </div>
              <div class="profile-info">
                <div class="profile-name">
                  <%= user.ssgNick || user.username %>
                </div>
                <div class="profile-detail"><span class="label">Username</span><span class="value">
                    <%= user.username %>
                  </span></div>
                <!-- Email -->
                <% if (isOwner || isLeadership) { %>
                  <div class="profile-detail"><span class="label">Email</span><span class="value" id="user-email">
                      <%= userEmail || 'Not provided' %>
                    </span></div>
                  <% } %>
                    <% if (user.factionPosition) { %>
                      <div class="profile-detail"><span class="label">Faction Position</span>
                        <span class="value">
                          <span class="role-badge role-<%= user.positionGroup || 'member' %>">
                            <%= user.factionPosition %>
                          </span>
                        </span>
                      </div>
                      <% } %>
              </div>
            </div>
            <!-- Leadership: Post Announcement -->
            <% if (isOwner || isLeadership) { %>
              <div id="announcement-form-card" class="card mt-2" style="border-left: 4px solid #2ecc71;">
                <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
                  <span>📝 Post to Message Board</span>
                  <button class="btn btn-small btn-outline" onclick="toggleAnnouncementForm()"
                    style="font-size:0.75rem;">+ New</button>
                </div>
                <div class="card-body" id="announcement-form-body" style="display:none;">
                  <textarea id="announcement-input" class="form-input" rows="3"
                    placeholder="Enter announcement message for all faction members..."
                    style="width:100%;resize:vertical;"></textarea>
                  <div style="display:flex;gap:0.5rem;margin-top:0.5rem;align-items:center;">
                    <button class="btn btn-primary btn-small" onclick="submitAnnouncement()">📢 Post</button>
                    <button class="btn btn-small btn-outline" onclick="toggleAnnouncementForm()">Cancel</button>
                    <span id="announcement-status" style="font-size:0.8rem;"></span>
                  </div>
                  <div id="announcement-history" style="margin-top:1rem;color:#888;"></div>
                </div>
              </div>
              <% } %>

                <!-- Announcement Block (all members) -->
                <div id="announcement-card" class="card mt-2" style="border-left: 4px solid #3498db; display:none;">
                  <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
                    <span>📢 Message Board</span>
                  </div>
                  <div class="card-body" id="announcement-body">
                    <div id="announcement-loading" class="empty-state" style="padding:0.5rem;">
                      <p class="muted" style="font-size:0.85rem;">Loading announcements...</p>
                    </div>
                    <div id="announcement-list" style="display:none;color:#888;"></div>
                    <div id="announcement-empty" class="empty-state" style="display:none;padding:0.5rem;">
                      <p class="muted" style="font-size:0.85rem;">No announcements yet.</p>
                    </div>
                  </div>
                </div>

                <!-- Torn Email
            <div class="card mt-2">
              <div class="card-header">📧 Torn Email Address</div>
              <% if (isOwner || isLeadership) { %>
                <div class="card-body">
                  <div style="display:flex;gap:0.5rem;align-items:center;">
                    <input type="email" id="email-input" class="form-input" value="<%= userEmail || '' %>"
                      placeholder="Enter your email address" style="flex:1;" />
                    <button class="btn btn-primary btn-small" onclick="saveUserEmail()">Save</button>
                  </div>
                  <div id="email-status" style="margin-top:0.5rem;"></div>
                </div>
                <% } %>
                  <div class="card-body">
                  </div>-->

                <!-- Personal Torn API Key -->
                <div class="card mt-2">
                  <div class="card-header">🔑 Torn API Key</div>
                  <div class="card-body">
                    <% if (tornApiKey) { %>
                      <p class="success-text">✅ Torn API key is saved.</p>
                      <button class="btn btn-small btn-outline" onclick="showKeyForm()">Update Key</button>
                      <% } else { %>
                        <p class="muted">No Torn API key saved yet. Add one to enable Torn stats.</p>
                        <% } %>
                          <div id="key-form" class="<%= tornApiKey ? 'hidden' : '' %>">
                            <div class="input-group mt-1">
                              <input type="text" id="torn-key-input" class="form-input"
                                placeholder="Enter your Torn API key..." />
                              <button class="btn btn-primary" onclick="saveTornKey()">Save Key</button>
                            </div>
                            <p class="hint">
                              Get your key at
                              <a href="https://www.torn.com/preferences.php#tab=api" target="_blank" rel="noopener">
                                torn.com → Preferences → API
                              </a>— set access level to <strong style="color:#c0bcbc;">Full Access</strong>.
                            </p>
                          </div>
                          <div id="key-status" class="mt-1"></div>
                  </div>
                </div>

                <!-- Faction API Key (Ownership only) -->
                <% if (isOwner) { %>
                  <div class="card mt-2">
                    <div class="card-header">🏰 Faction API Key <span
                        style="font-size:0.75rem;color:#666;font-weight:400;">(Ownership only)</span></div>
                    <div class="card-body">
                      <% if (hasFactionKey) { %>
                        <p class="success-text">✅ Faction API key is configured.</p>
                        <button class="btn btn-small btn-outline" onclick="showFactionKeyForm()">Update Key</button>
                        <% } else { %>
                          <p class="muted">No faction API key set. Configure one to enable faction features for all
                            members.
                          </p>
                          <% } %>
                            <div id="faction-key-form" class="<%= hasFactionKey ? 'hidden' : '' %>">
                              <div class="input-group mt-1">
                                <input type="text" id="faction-key-input" class="form-input"
                                  placeholder="Enter faction Torn API key..." />
                                <button class="btn btn-primary" onclick="saveFactionKey()">Save Key</button>
                              </div>
                              <p class="hint">Use a faction leader/co-leader's Torn API key with faction permissions.
                              </p>
                            </div>
                            <div id="faction-key-status" class="mt-1"></div>
                    </div>
                  </div>
                  <% } %>

                  <!-- Role View Selector (visible based on actual permissions, not impersonated role) -->
                  <% if (realIsOwner) { %>
                  <div class="card mt-2">
                    <div class="card-header">👁️ View As Role <span
                        style="font-size:0.75rem;color:#666;font-weight:400;">(Ownership only)</span></div>
                    <div class="card-body">
                      <p class="muted mb-1">Preview the dashboard exactly as other roles would see it:</p>
                      <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                        <select id="role-view-selector" class="channel-dropdown" style="min-width:180px;">
                          <option value="" <%=!isImpersonating ? 'selected' : '' %>>— My Normal View —</option>
                          <% availableRoles.forEach(function(role) { %>
                            <option value="<%= role %>" <%=impersonatedRole===role ? 'selected' : '' %>><%=
                                role.charAt(0).toUpperCase() + role.slice(1) %>
                            </option>
                            <% }); %>
                        </select>
                        <button class="btn btn-primary btn-small" onclick="switchRoleView()">Apply View</button>
                        <% if (isImpersonating) { %>
                          <span class="success-text" style="font-size:0.85rem;">✅ Currently viewing as <strong>
                              <%= impersonatedRole %>
                            </strong> role</span>
                          <% } %>
                      </div>
                      <p class="hint mt-1">This changes what training materials and features are visible.
                        Does not affect your actual permissions.</p>
                    </div>
                  </div>
                  <% } %>


                    <!-- Ownership Notification Card (ownership only) -->
                    <% if (isOwner) { %>
                      <div id="notification-card" class="card mt-2"
                        style="border-left: 4px solid var(--ownership-color, #e67e22); display:none;">
                        <div class="card-header" style="display:flex;justify-content:space-between;align-items:center;">
                          <span id="notification-title">📬 Notifications</span>
                          <span id="notification-badge"
                            style="background:#e74c3c;color:white;border-radius:12px;padding:2px 8px;font-size:0.75rem;display:none;">0</span>
                        </div>
                        <div class="card-body" id="notification-body">
                          <div id="notification-loading" class="empty-state" style="padding:0.5rem;">
                            <p class="muted" style="font-size:0.85rem;">Loading notifications...</p>
                          </div>
                          <div id="notification-list" style="display:none;"></div>
                          <div id="notification-empty" class="empty-state" style="display:none;padding:0.5rem;">
                            <p class="muted" style="font-size:0.85rem;">No recent notifications.</p>
                          </div>
                        </div>
                      </div>
                      <% } %>
          </section>
          <% } %>


          <!-- ── TORN STATS ── -->
          <section id="torn" class="section">
            <div class="section-header">
              <h3>Your Personal Stats</h3>
              <button class="btn btn-primary btn-small" onclick="refreshTornUserData()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('torn')">❓ Help</button>
            </div>
            <div id="torn-user-data">
              <div class="empty-state">
                <span class="empty-icon">🎮</span>
                <p>Click Refresh to load your stats.</p>
                <p class="muted">Make sure your API key is saved in your profile.</p>
              </div>
            </div>

            <div class="section-header" style="margin-top:2rem;">
              <h3>Honors, Merits & Awards</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <select id="honors-filter" class="channel-dropdown" onchange="filterHonors()">
                  <option value="all">All</option>
                  <option value="earned">Earned only</option>
                  <option value="unearned">Not earned</option>
                </select>
                <select id="honors-sort" class="channel-dropdown" onchange="filterHonors()">
                  <option value="earned-first">Earned first</option>
                  <option value="unearned-first">Unearned first</option>
                  <option value="rarity-asc">Rarity (rarest first)</option>
                  <option value="rarity-desc">Rarity (common first)</option>
                  <option value="name">Name A-Z</option>
                </select>
                <button class="btn btn-primary btn-small" onclick="fetchHonors()">Load</button>
              </div>
            </div>
            <div id="honors-data">
              <div class="empty-state">
                <span class="empty-icon">🏅</span>
                <p>Click Load to fetch your honors, merits and awards.</p>
              </div>
            </div>
            <div id="honors-table-container"></div>

            <div class="section-header" style="margin-top:2rem;">
              <h3>Crime Record</h3>
              <button class="btn btn-primary btn-small" onclick="fetchCrimeExp()">Load</button>
            </div>
            <div id="crime-exp-data">
              <div class="empty-state">
                <span class="empty-icon">🔪</span>
                <p>Click Load to fetch your crime record.</p>
              </div>
            </div>

            <!-- Racing Stats -->
            <div class="section-header" style="margin-top:2rem;">
              <h3>Racing Stats</h3>
              <div style="display:flex;gap:0.75rem;align-items:center;flex-wrap:wrap;">
                <label style="font-size:0.75rem;color:#888;">Last</label>
                <input id="racing-limit" type="number" value="100" min="1" max="1000"
                  style="width:60px;background:#1a1919;border:1px solid #333;color:#c0bcbc;border-radius:4px;padding:2px 6px;font-size:0.8rem;">
                <label style="font-size:0.75rem;color:#888;">races</label>
                <button class="btn btn-primary btn-small" onclick="fetchRacingStats()">Load</button>
              </div>
            </div>
            <div id="racing-stats-data">
              <div class="empty-state">
                <span class="empty-icon">🏎️</span>
                <p>Set a limit and click Load to fetch your racing stats.</p>
              </div>
            </div>
          </section>

          <!-- ── TARGETS ── -->
          <section id="targets" class="section">
            <div class="section-header">
              <h3>🎯 Target Finder</h3>
              <button class="btn btn-primary btn-small" onclick="fetchTargets()">↻ Load Targets</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('targets')">❓ Help</button>
            </div>

            <!-- FFScouter API Key Card -->
            <div class="card mt-2">
              <div class="card-header">🔑 FFScouter API Key</div>
              <div class="card-body">
                <p class="muted" style="font-size:0.85rem;">
                  Enter your FFScouter API key to enable the target finder. Get one at
                  <a href="https://ffscouter.com/" target="_blank" rel="noopener" style="color:#00ADB5;">ffscouter.com</a>
                  (generate a custom API key in your profile settings).
                </p>
                <div id="ffscouter-key-status" class="mt-1"></div>
                <div id="ffscouter-key-form">
                  <div class="input-group mt-1">
                    <input type="text" id="ffscouter-key-input" class="form-input"
                      placeholder="Enter your 16-character FFScouter API key..." />
                    <button class="btn btn-primary" onclick="saveFFScouterKey()">Save Key</button>
                  </div>
                  <p class="hint" style="font-size:0.78rem;">
                    Your key is stored securely and never exposed to the browser. Used only to call FFScouter APIs.
                  </p>
                </div>
              </div>
            </div>

            <!-- Filters -->
            <div class="card mt-2" style="background:#1a1919;border:1px solid #2a2828;">
              <div class="card-body">
                <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:flex-end;">
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Preset</label>
                    <select id="target-preset" class="channel-dropdown" style="min-width:160px;" onchange="togglePresetFilters()">
                      <option value="">Custom Filters</option>
                      <option value="respect">🎯 Respect Preset</option>
                      <option value="level">📊 Level Preset</option>
                    </select>
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Min Level</label>
                    <input type="number" id="target-minlevel" class="form-input" value="1" min="1" max="100" style="width:70px;" />
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Max Level</label>
                    <input type="number" id="target-maxlevel" class="form-input" value="100" min="1" max="100" style="width:70px;" />
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Min FF</label>
                    <input type="number" id="target-minff" class="form-input" value="1" min="1" step="0.1" style="width:70px;" />
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Max FF</label>
                    <input type="number" id="target-maxff" class="form-input" value="3" min="1" step="0.1" style="width:70px;" />
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">Limit</label>
                    <input type="number" id="target-limit" class="form-input" value="25" min="1" max="50" style="width:70px;" />
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">&nbsp;</label>
                    <label style="display:flex;align-items:center;gap:0.3rem;cursor:pointer;font-size:0.85rem;color:#888">
                      <input type="checkbox" id="target-factionless" /> Factionless only
                    </label>
                  </div>
                  <div>
                    <label style="font-size:0.75rem;color:#555;text-transform:uppercase;letter-spacing:0.06em;display:block;margin-bottom:0.3rem;">&nbsp;</label>
                    <div style="display:flex;gap:0.5rem;">
                      <button class="btn btn-primary btn-small" onclick="fetchTargets()">🔍 Find Targets</button>
                      <button class="btn btn-small btn-outline" onclick="resetTargetFilters()">Reset</button>
                    </div>
                  </div>
                </div>
                <p class="hint mt-1" style="font-size:0.78rem;">
                  Inactive players (14+ days) are shown by default. Results are based on your battle stats via FFScouter.
                </p>
              </div>
            </div>

            <!-- Results -->
            <div id="targets-data" class="mt-2">
              <div class="empty-state">
                <span class="empty-icon">🎯</span>
                <p>Click <strong>Load Targets</strong> or <strong>Find Targets</strong> to find inactive players you can attack.</p>
                <p class="muted">Make sure your FFScouter API key is saved above.</p>
              </div>
            </div>
          </section>

          <!-- ── FACTION ── -->
          <section id="faction" class="section">
            <div class="section-header">
              <h3>Faction Stats</h3>
              <button class="btn btn-primary btn-small" onclick="fetchFaction()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('faction')">❓ Help</button>
            </div>
            <div id="faction-data">
              <div class="empty-state">
                <span class="empty-icon">⚔️</span>
                <p>Click Refresh to load faction data.</p>
              </div>
            </div>

          </section>

          <!-- ── TRAVEL ── -->
          <section id="travel" class="section">
            <div class="section-header">
              <h3>Travel Status</h3>
              <button class="btn btn-primary btn-small" onclick="fetchTravel()">↻ Refresh</button>
              <button class="btn btn-small btn-outline" onclick="openHelp('travel')">❓ Help</button>
            </div>

            <div id="travel-status">
              <div class="empty-state">
                <span class="empty-icon">✈️</span>
                <p>Click Refresh to load your travel status.</p>
              </div>
            </div>

            <!-- Stock Observer Userscript Install -->
            <div class="card mt-2" style="background:#1a1919;border:1px solid #2a2828;">
              <div class="card-body" style="padding:0.85rem 1.25rem;">
                <div style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between;">
                  <div style="flex:1;min-width:200px;">
                    <div style="font-size:0.9rem;font-weight:600;margin-bottom:0.25rem;color:#888;">🔄 SSG Stock
                      Observer</div>
                    <div style="font-size:0.8rem;color:#888;">Automatically submits stock data when you visit
                      torn.com/travel.php while abroad. Works on PC (Tampermonkey) and Torn PDA (Userscripts/Kiwi).
                    </div>
                  </div>
                  <div style="display:flex;gap:0.5rem;flex-wrap:wrap;">
                    <!-- FIX: Changed href to use the absolute URL to your Onrender server -->
                    <a href="https://ssg-server.onrender.com/js/ssg-stock-observer.user.js"
