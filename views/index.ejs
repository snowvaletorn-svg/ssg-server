<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>S.S.G - Strategy | Strength | Growth</title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body>
  <div class="navbar">
    <div class="container" style="text-align: center; padding-top: 20px;">
      <!-- Logo: Max width 100% ensures it shrinks on mobile -->
      <img src="/images/ssg-logo.gif" alt="SSG Logo" style="width: 100%; max-width: 800px; height: auto;">


      <h1>S.S.G - Strategy | Strength | Growth</h1>

      <div class="nav-links">
        <% if (user) { %>
          <p style="color: var(--card-bg);">Hi, <strong>
              <%= user.username %>
            </strong>!</p>
          <a href="/dashboard" class="btn"
            style="background: var(--ownership-color); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 5px;">Dashboard</a>
          <a href="/logout" class="btn"
            style="background: var(--strategy-color); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 5px;">Logout</a>
          <% } else { %>
            <a href="/auth/discord" class="btn"
              style="background: var(--ownership-color); color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px; display: inline-block;">Discord
              Login</a>
            <% } %>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="faction-description">
      <p>Welcome to S.S.G, where strategy, strength, and growth define everything we do. We're more than just a
        faction—we're a team built on trust, teamwork, and the drive to succeed together.</p>

      <div class="desc-grid">
        <div class="desc-card" style="border-left-color: var(--strategy-color); padding: 15px;">
          <h4>Strategy</h4>
          <p>Every move we make is calculated.</p>
        </div>
        <div class="desc-card" style="border-left-color: var(--strength-color); padding: 15px;">
          <h4>Strength</h4>
          <p>We train hard, fight smart, and back each other up.</p>
        </div>
        <div class="desc-card" style="border-left-color: var(--growth-color); padding: 15px;">
          <h4>Growth</h4>
          <p>We'll help you level up fast with guidance and faction perks.</p>
        </div>
      </div>

      <h2 style="text-align: center; margin-top: 40px;">Faction Perks</h2>
      <div class="perks-grid">
        <div class="perks-card" style="padding: 15px;">
          <h4>Weapons</h4>
          <p>Provided by faction</p>
        </div>
        <div class="perks-card" style="padding: 15px;">
          <h4>Armor</h4>
          <p>Provided by faction</p>
        </div>
        <div class="perks-card" style="padding: 15px;">
          <h4>Medical</h4>
          <p>Kits, morphine, and blood</p>
        </div>
        <div class="perks-card" style="padding: 15px;">
          <h4>Drugs</h4>
          <p>Xanax & Vicodin for war</p>
        </div>
        <div class="perks-card" style="padding: 15px;">
          <h4>Travel</h4>
          <p>+7 items, 15% cost reduction</p>
        </div>
      </div>

      <div class="stat-card" style="margin-top: 40px; text-align: left; border-top: 4px solid var(--growth-color);">
        <h2 style="margin-top: 0;">What we expect from you:</h2>
        <ul style="color: var(--black);">
          <li>Daily activity in discord and in game</li>
          <li>Join OC (90% payout)</li>
          <li>Join In with war and chaining</li>
          <li>Most Importantly, have fun!</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Faction Stats -->
  <div class="container">
    <div class="faction-stats">
      <div class="stat-card">
        <h4>29</h4>
        <p>Total Members</p>
      </div>
      <div class="stat-card">
        <h4>5</h4>
        <p>Teams</p>
      </div>
    </div>
  </div>

  <!-- Groups Section -->
  <section class="container">
    <div class="groups-section">
      <h2>Our Groups</h2>
      <p class="section-intro">Each division plays a vital role in our faction's success</p>
      <div class="groups-grid">
        <div class="owner-card">
          <div class="group-header">
            <h3>Ownership</h3><span class="group-members">3 Members</span>
          </div>
          <p class="group-description">Owners have final decision on all aspects and are available to assist/train.</p>
          <div class="group-footer">
            <p><strong>Focus:</strong> Ensuring understanding across all teams.</p>
          </div>
        </div>
        <div class="lead-card">
          <div class="group-header">
            <h3>Leadership</h3><span class="group-members">2 Members</span>
          </div>
          <p class="group-description">Helping determine the faction path and day-to-day operations.</p>
          <div class="group-footer">
            <p><strong>Focus:</strong> Team success and operations.</p>
          </div>
        </div>
        <div class="strat-card">
          <div class="group-header">
            <h3>Strategy</h3><span class="group-members">4 Members</span>
          </div>
          <p class="group-description">Level 15+ members who plan and execute war rules.</p>
          <div class="group-footer">
            <p><strong>Focus:</strong> Preparing Strength and Growth for war.</p>
          </div>
        </div>
        <!--Strength Card-->
        <div class="stren-card">
          <div class="group-header">
            <h3>
              Strength
            </h3>
            <span class="group-members">
              17 Members</span>
          </div>
          <p class="group-description">
            This team is made up of members at level 15 or greater. Their focus is on stats (and playing the rest of the
            game).
          </p>
          <div class="group-footer">
            <p><strong>focus:</strong>
              Making money to purchase items for stats growth and to be able to rent a Private Island with an airstrip.
            </p>
          </div>
        </div>
        <!--Growth Card-->
        <div class="grow-card">
          <div class="group-header">
            <h3>
              Growth
            </h3>
            <span class="group-members">
              3 Members</span>
          </div>
          <p class="group-description">
            This team is made up of members under level 15.
          </p>
          <div class="group-footer">
            <p><strong>focus:</strong>
              Making their way to level 15 through attacks (leaving their opponent), crimes, and training in the gym.
            </p>
          </div>
        </div>
      </div>
    </div>
    </div>
  </section>
</body>

</html>