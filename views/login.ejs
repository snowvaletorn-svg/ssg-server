<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - S.S.G</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .login-container {
      max-width: 500px;
      margin: 40px auto;
      padding: 0 20px;
    }

    .login-card {
      background: var(--card-bg);
      border-radius: 12px;
      padding: 40px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .login-title {
      text-align: center;
      margin-bottom: 10px;
      color: var(--text-color);
    }

    .login-subtitle {
      text-align: center;
      color: #888;
      margin-bottom: 30px;
      font-size: 14px;
    }

    .login-field {
      margin-bottom: 20px;
    }

    .login-label {
      display: block;
      margin-bottom: 8px;
      color: var(--text-color);
      font-weight: 600;
      font-size: 14px;
    }

    .login-input {
      width: 100%;
      padding: 12px 16px;
      background: rgba(0, 0, 0, 0.3);
      border: 2px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      color: var(--text-color);
      font-size: 14px;
      transition: border-color 0.3s ease;
      box-sizing: border-box;
    }

    .login-input:focus {
      outline: none;
      border-color: var(--strategy-color);
    }

    .login-input::placeholder {
      color: #666;
    }

    .login-help {
      font-size: 12px;
      color: #888;
      margin-top: 6px;
    }

    .login-btn {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, var(--ownership-color), #c0392b);
      color: white;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      margin-top: 10px;
    }

    .login-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(231, 76, 60, 0.4);
    }

    .login-btn:active {
      transform: translateY(0);
    }

    .login-btn:disabled {
      opacity: 0.6;
      cursor: not-allowed;
      transform: none;
    }

    .login-status {
      margin-top: 15px;
      padding: 12px;
      border-radius: 8px;
      font-size: 14px;
      text-align: center;
      display: none;
    }

    .login-status.success {
      background: rgba(46, 204, 113, 0.2);
      color: #2ecc71;
      border: 1px solid rgba(46, 204, 113, 0.3);
    }

    .login-status.error {
      background: rgba(231, 76, 60, 0.2);
      color: #e74c3c;
      border: 1px solid rgba(231, 76, 60, 0.3);
    }

    .login-status.loading {
      background: rgba(52, 152, 219, 0.2);
      color: #3498db;
      border: 1px solid rgba(52, 152, 219, 0.3);
    }

    .login-divider {
      text-align: center;
      margin: 25px 0;
      color: #666;
      font-size: 12px;
    }

    .back-link {
      display: inline-block;
      margin-top: 20px;
      color: var(--strategy-color);
      text-decoration: none;
      font-size: 14px;
    }

    .back-link:hover {
      text-decoration: underline;
    }

    .api-key-info {
      background: rgba(52, 152, 219, 0.1);
      border: 1px solid rgba(52, 152, 219, 0.2);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 25px;
    }

    .api-key-info h4 {
      margin: 0 0 8px 0;
      color: var(--strategy-color);
      font-size: 14px;
    }

    .api-key-info p {
      margin: 0;
      font-size: 12px;
      color: #888;
      line-height: 1.5;
    }

    .api-key-info a {
      color: var(--strategy-color);
      text-decoration: none;
    }

    .api-key-info a:hover {
      text-decoration: underline;
    }
  </style>
</head>

<body>
  <div class="navbar">
    <div class="container" style="text-align: center; padding: 15px 0;">
      <a href="/" style="text-decoration: none;">
        <h1 style="margin: 0; color: var(--text-color);">S.S.G</h1>
      </a>
    </div>
  </div>

  <div class="login-container">
    <div class="login-card">
      <h2 class="login-title">Login with Torn</h2>
      <p class="login-subtitle">Enter your Torn credentials to access the dashboard</p>

      <div class="api-key-info">
        <h4>🔑 API Key Required</h4>
        <p>You need a <strong>Full Access</strong> API key from Torn. 
          Get it from your Torn settings: 
          <a href="https://www.torn.com/preferences.php#tab=api" target="_blank" rel="noopener">Torn API Settings</a>
        </p>
      </div>

      <form id="loginForm" onsubmit="handleLogin(event)">
        <div class="login-field">
          <label class="login-label" for="tornName">Torn Username</label>
          <input type="text" id="tornName" class="login-input" placeholder="e.g. Chedburn_Jr_Rocks" required autocomplete="username">
          <p class="login-help">Your in-game username (case-sensitive)</p>
        </div>

        <div class="login-field">
          <label class="login-label" for="tornId">Torn ID</label>
          <input type="number" id="tornId" class="login-input" placeholder="e.g. 1234567" required autocomplete="off">
          <p class="login-help">The number in brackets after your name on your profile</p>
        </div>

        <div class="login-field">
          <label class="login-label" for="apiKey">API Key</label>
          <input type="password" id="apiKey" class="login-input" placeholder="Enter your Full Access API key" required autocomplete="current-password">
          <p class="login-help">Must be a Full Access key (starts with numbers, ~64 characters)</p>
        </div>

        <div class="login-field" style="display: flex; align-items: center; gap: 10px;">
          <input type="checkbox" id="stayLoggedIn" style="width: 18px; height: 18px; cursor: pointer;">
          <label for="stayLoggedIn" style="color: var(--text-color); font-size: 14px; cursor: pointer;">
            Stay logged in (100 hours) - Session resets on each visit
          </label>
        </div>

        <button type="submit" class="login-btn" id="loginBtn">
          Login
        </button>
      </form>

      <div id="loginStatus" class="login-status"></div>

      <div style="text-align: center;">
        <a href="/" class="back-link">← Back to Home</a>
      </div>
    </div>
  </div>

  <script>
    async function handleLogin(event) {
      event.preventDefault();

      const tornName = document.getElementById('tornName').value.trim();
      const tornId = document.getElementById('tornId').value.trim();
      const apiKey = document.getElementById('apiKey').value.trim();
      const statusEl = document.getElementById('loginStatus');
      const loginBtn = document.getElementById('loginBtn');

      // Basic validation
      if (!tornName || !tornId || !apiKey) {
        showStatus('Please fill in all fields.', 'error');
        return;
      }

      // Validate Torn ID is a number
      if (!/^\d+$/.test(tornId)) {
        showStatus('Torn ID must be a number.', 'error');
        return;
      }

      // Disable button and show loading
      loginBtn.disabled = true;
      loginBtn.textContent = 'Verifying...';
      showStatus('Verifying your credentials with Torn...', 'loading');

      const stayLoggedIn = document.getElementById('stayLoggedIn').checked;

      try {
        const response = await fetch('/api/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            tornName,
            tornId: parseInt(tornId),
            apiKey,
            stayLoggedIn
          })
        });

        const data = await response.json();

        if (response.ok) {
          showStatus('✅ Login successful! Redirecting...', 'success');
          setTimeout(() => {
            window.location.href = '/dashboard';
          }, 1500);
        } else {
          showStatus(`❌ ${data.error}`, 'error');
          loginBtn.disabled = false;
          loginBtn.textContent = 'Login';
        }
      } catch (err) {
        showStatus('❌ Connection error. Please try again.', 'error');
        loginBtn.disabled = false;
        loginBtn.textContent = 'Login';
      }
    }

    function showStatus(message, type) {
      const statusEl = document.getElementById('loginStatus');
      statusEl.textContent = message;
      statusEl.className = `login-status ${type}`;
      statusEl.style.display = 'block';
    }
  </script>
</body>

</html>